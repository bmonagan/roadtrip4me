# Backend API base URL
# Production value: https://api.roadtrip4me.com
VITE_API_URL=https://roadtrip4me-api.fly.dev

# Mapbox — required for interactive maps in the frontend
VITE_MAPBOX_TOKEN=

# Dev-only: fallback user ID when running without Auth0
VITE_DEV_USER_ID=user_alice

# Auth0 (SPA) — fill in for production Auth0 integration.
# Leave empty to stay in dev mode (x-user-id header fallback).
# Example: VITE_AUTH0_DOMAIN=roadtrip4me.us.auth0.com
VITE_AUTH0_DOMAIN=
# Auth0 SPA Application Client ID (from Auth0 dashboard → Applications → your web app)
VITE_AUTH0_CLIENT_ID=
# Must match the API audience configured on the backend
# Production value: https://api.roadtrip4me.com
VITE_AUTH0_AUDIENCE=
