// Roadtrip4me — Prisma Schema
// Database: PostgreSQL 16 + PostGIS 3.4
//
// Geography columns use Unsupported("geography(Point, 4326)") because Prisma
// does not natively model PostGIS types. Spatial queries must be written as
// raw SQL via prisma.$queryRaw. All other columns are fully type-safe.
//
// To apply:
//   bunx prisma migrate dev --name init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "bun"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TripStatus {
  draft
  planned
  in_progress
  completed
}

enum TripVibe {
  scenic
  foodie
  adventure
  historic
  relaxed
  family
}

enum StopCategory {
  restaurant
  attraction
  gas_station
  lodging
  park
  viewpoint
  campground
  museum
  shopping
  other
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  // authId is the sub claim from Auth0 — used to look up the user on every
  // authenticated request. Indexed and unique so the lookup is O(1).
  authId      String   @unique
  email       String   @unique
  displayName String
  avatarUrl   String?
  isPremium        Boolean  @default(false)
  stripeCustomerId String?  @unique
  // Daily AI recommendation budget (counters reset when the date rolls over).
  recommendationCount    Int       @default(0)
  recommendationCountDay DateTime? @db.Date
  createdAt        DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips           Trip[]
  votes           Vote[]
  submittedStops  Stop[]       @relation("SubmittedBy")
  savedStops      SavedStop[]
  collaborations  TripCollaborator[]

  @@map("users")
}

// ─── Trip ────────────────────────────────────────────────────────────────────

model Trip {
  id          String     @id @default(cuid())
  userId      String
  title       String
  status      TripStatus @default(draft)
  vibes       TripVibe[]

  // Origin stored as flat columns + geography point for spatial queries.
  // The geography column is excluded from Prisma's generated types and must
  // be set via a raw query on insert:
  //   INSERT INTO trips (..., origin_point) VALUES (..., ST_Point(lng, lat)::geography)
  originLabel String
  originLat   Float
  originLng   Float
  originPoint Unsupported("geography(Point, 4326)")?

  // Destination
  destLabel   String
  destLat     Float
  destLng     Float
  destPoint   Unsupported("geography(Point, 4326)")?

  startDate   DateTime?
  endDate     DateTime?

  // Populated by the Google Maps Directions API call in TripsService.
  totalDistanceMeters   Int?
  totalDurationSeconds  Int?
  // Encoded polyline from the Directions API response — used by Mapbox to
  // render the route line without storing every coordinate.
  encodedPolyline       String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  waypoints            TripWaypoint[]
  tripStops            TripStop[]
  collaborators        TripCollaborator[]
  recommendationRequests RecommendationRequest[]

  // Most queries are "trips for this user, newest first"
  @@index([userId, createdAt(sort: Desc)])
  @@map("trips")
}

// ─── Trip Collaborator ───────────────────────────────────────────────────────
// Users other than the owner who can view and edit a trip. The owner is not
// stored here — ownership is Trip.userId. Editing is allowed for collaborators,
// deleting and collaborator management are owner-only.

model TripCollaborator {
  id      String   @id @default(cuid())
  tripId  String
  userId  String
  addedAt DateTime @default(now())

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_collaborators")
}

// ─── Trip Waypoint ────────────────────────────────────────────────────────────
// Intermediate points on a route defined by the user (not community stops).
// order determines sequence; stopId is set when the waypoint was snapped to
// an existing Stop record, null when it's a freeform user-placed pin.

model TripWaypoint {
  id      String  @id @default(cuid())
  tripId  String
  order   Int
  label   String
  lat     Float
  lng     Float
  stopId  String?

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop    Stop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)

  // Each waypoint has a unique position within its trip
  @@unique([tripId, order])
  @@index([tripId])
  @@map("trip_waypoints")
}

// ─── Stop ────────────────────────────────────────────────────────────────────
// A point of interest — either AI-suggested, community-submitted, or imported
// from Google Places / Yelp. score is a denormalized cache of the vote sum
// updated in a transaction every time a vote is cast or changed.

model Stop {
  id                String       @id @default(cuid())
  name              String
  description       String?
  category          StopCategory
  imageUrl          String?

  // Flat columns for Prisma reads; geography column for PostGIS spatial queries.
  lat               Float
  lng               Float
  location          Unsupported("geography(Point, 4326)")?

  // Address fields stored flat for simple display — no join needed.
  street            String?
  city              String
  state             String
  country           String        @default("US")
  postalCode        String?

  // externalId links to the source record in Google Places or Yelp so we can
  // enrich stop data without duplicate entries.
  externalId        String?      @unique
  externalSource    String?      // "google_places" | "yelp" | "manual" | "ai"

  // Denormalized vote aggregates — updated via transaction in VotesService.
  // Never query SUM(votes.value) at read time; always read these columns.
  score             Int          @default(0)
  voteCount         Int          @default(0)

  submittedByUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  submittedBy       User?        @relation("SubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  votes             Vote[]
  tripStops         TripStop[]
  waypoints         TripWaypoint[]
  savedBy           SavedStop[]

  // Spatial index created manually in the migration (Prisma can't express it):
  // CREATE INDEX stops_location_idx ON stops USING GIST (location);
  //
  // Used by: ST_DWithin(location, route_geography, detour_meters)

  @@index([category])
  @@index([score(sort: Desc)])   // "top stops" queries
  @@index([city, state])         // "stops near city" text queries
  @@map("stops")
}

// ─── Trip Stop ────────────────────────────────────────────────────────────────
// Join table between a Trip and the Stops added to it. order determines the
// sequence the stop appears in the itinerary. A stop can appear in many trips.

model TripStop {
  id        String   @id @default(cuid())
  tripId    String
  stopId    String
  order     Int
  addedAt   DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([tripId, stopId])      // A stop can only appear once per trip
  @@unique([tripId, order])       // Each position in a trip is unique
  @@index([tripId])
  @@map("trip_stops")
}

// ─── Vote ─────────────────────────────────────────────────────────────────────
// value is constrained to 1 or -1 at the application layer (NestJS DTO) and
// enforced by the DB check constraint added in the migration:
//   ALTER TABLE votes ADD CONSTRAINT votes_value_check CHECK (value IN (1, -1));
//
// The unique constraint on (userId, stopId) means a user can only hold one
// vote position per stop — casting a new vote replaces the old one via upsert.

model Vote {
  id        String   @id @default(cuid())
  userId    String
  stopId    String
  value     Int      // 1 = upvote, -1 = downvote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  // One vote position per user per stop. Upsert on this constraint to
  // change vote direction rather than inserting a second row.
  @@unique([userId, stopId])
  @@index([stopId])   // Fast aggregation when recalculating stop.score
  @@map("votes")
}

// ─── Saved Stop ───────────────────────────────────────────────────────────────
// Users can bookmark stops independently of trips — a personal "want to visit"
// list. Separate from TripStop so saves persist even if the trip is deleted.

model SavedStop {
  id      String   @id @default(cuid())
  userId  String
  stopId  String
  savedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stop    Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([userId, stopId])
  @@index([userId])
  @@map("saved_stops")
}

// ─── Recommendation Request ───────────────────────────────────────────────────
// Tracks the state of an async AI recommendation generation request per trip.
// One active request per trip at a time; completed results stored as JSONB.

enum RecommendationStatus {
  pending
  processing
  completed
  failed
}

model RecommendationRequest {
  id        String                 @id @default(cuid())
  tripId    String
  status    RecommendationStatus   @default(pending)
  stops     Json?                 // RecommendedStop[] array on completion
  error     String?               // Failure reason
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId])              // One active request per trip
  @@map("recommendation_requests")
}
