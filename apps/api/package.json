{
  "name": "@roadtrip4me/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun --external '@nestjs/microservices' --external '@nestjs/platform-express' --external '@nestjs/websockets' --external '@fastify/cors' --external '@fastify/middie' --external '@fastify/static' --external '@fastify/view'",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "bunx eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "@googlemaps/polyline-codec": "^1.0.28",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-fastify": "^10.4.1",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "@roadtrip4me/types": "workspace:*",
    "@types/pg": "^8.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  }
}
