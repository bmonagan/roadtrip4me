PORT=3000
# Comma-separated list of allowed browser origins (or * in dev)
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadtrip4me

# Redis

# Auth — set AUTH_DISABLED=false and configure AUTH0_DOMAIN/AUTH0_AUDIENCE to
# enforce real token auth. AUTH_DISABLED=true enables the local dev fallback
# that trusts the x-user-id header.
AUTH_DISABLED=true

# Auth0 — fill in your tenant domain and API audience.
# Example: AUTH0_DOMAIN=roadtrip4me.us.auth0.com
AUTH0_DOMAIN=
# The Auth0 API identifier (Audience) — used as scope in JWT requests.
# Production value: https://api.roadtrip4me.com
AUTH0_AUDIENCE=
# External APIs
# Google Maps — for geocoding, directions, and Places API
GOOGLE_MAPS_API_KEY=
# DeepSeek — for AI trip planning and itinerary generation
DEEPSEEK_API_KEY=
# Yelp — for local business/search integration
YELP_API_KEY=

# Affiliate — booking partner IDs for revenue sharing
BOOKING_COM_AFFILIATE_ID=
EXPEDIA_AFFILIATE_ID=

# App origin (used by Stripe success/cancel URLs and redirect callbacks)
# Production value: https://roadtrip4me.com
APP_ORIGIN=http://localhost:5173

# Billing (Stripe) — for premium subscriptions
# Secret key from Stripe dashboard
STRIPE_SECRET_KEY=
# Price ID for the subscription plan (from Stripe dashboard → Products → Prices)
STRIPE_PRICE_ID=
# Webhook signing secret (from Stripe → Developers → Webhooks → Endpoint secrets)
STRIPE_WEBHOOK_SECRET=
