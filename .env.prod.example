# ============================================================
# RoadTrip4Me — Production Environment Configuration
# ============================================================
# Fly.io deployment: secrets are set via `flyctl secrets set` or
# in the GitHub Actions workflow (see .github/workflows/deploy.yml).
# This file is a reference for required environment variables.
# Do NOT commit this file with secrets.
# ============================================================

# ============================================================
# Network
# ============================================================
# Fly.io handles HTTPS/TLS globally. No Caddy/reverse proxy needed.
# CORS origin — your production domain
CORS_ORIGIN=https://roadtrip4me.com

# App origin — used by Stripe success/cancel URLs and redirect callbacks
APP_ORIGIN=https://roadtrip4me.com

# ============================================================
# Database
# ============================================================
# Fly Postgres — connection string from `fly postgres info`
# Example: postgres://user:password@roadtrip4me-db.internal:5432/roadtrip4me
DATABASE_URL=


# ============================================================
# Auth0 — Authentication & Authorization
# ============================================================
# Auth0 tenant domain (e.g., roadtrip4me.us.auth0.com)
AUTH0_DOMAIN=

# Auth0 API Audience — the identifier for your Auth0 API resource
AUTH0_AUDIENCE=

# Auth0 SPA Application Client ID
AUTH0_CLIENT_ID=

# Auth0 SPA Application Client Secret
AUTH0_CLIENT_SECRET=

# Auth0 JWKS URL (derived from domain: https://{AUTH0_DOMAIN}/.well-known/jwks.json)
AUTH0_JWKS_URL=

# ============================================================
# Frontend Auth0 (baked into Vite build at CI time)
# ============================================================
# SPA Application Client ID
VITE_AUTH0_CLIENT_ID=

# Must match AUTH0_DOMAIN above
VITE_AUTH0_DOMAIN=

# Must match AUTH0_AUDIENCE above
VITE_AUTH0_AUDIENCE=

# ============================================================
# Map & Geocoding
# ============================================================
# Mapbox access token — baked into Vite build at CI time
VITE_MAPBOX_TOKEN=

# Google Maps API key — for geocoding, directions, and Places
GOOGLE_MAPS_API_KEY=

# Mapbox access token for server-side use
MAPBOX_ACCESS_TOKEN=

# ============================================================
# AI Services
# ============================================================
# DeepSeek API key — for AI-powered trip planning
DEEPSEEK_API_KEY=

# ============================================================
# Local Search
# ============================================================
# Yelp API key — for local business discovery (optional)
YELP_API_KEY=

# ============================================================
# Affiliate Partners
# ============================================================
# Booking.com affiliate ID
BOOKING_COM_AFFILIATE_ID=

# Booking.com sub-account id (optional)
BOOKING_COM_SID=

# Live Booking.com inventory — opt-in once the Affiliate API is approved.
BOOKING_COM_API_ENABLED=false
# Affiliate API endpoint + token supplied with partner approval.
BOOKING_COM_API_URL=
BOOKING_COM_API_TOKEN=

# Expedia affiliate ID
EXPEDIA_AFFILIATE_ID=

# Expedia Travel Redirect tenant id (optional)
EXPEDIA_TRAVELER_ID=

# ============================================================
# Billing — Stripe (Premium Subscriptions)
# ============================================================
# Stripe Secret Key — starts with sk_live_ in production
STRIPE_SECRET_KEY=

# Stripe Price ID — subscription plan price identifier
STRIPE_PRICE_ID=

# Stripe Webhook Signing Secret
STRIPE_WEBHOOK_SECRET=

# Stripe Webhook Endpoint Secret (for verifying webhook events)
STRIPE_WEBHOOK_ENDPOINT_SECRET=

# ============================================================
# Session
# ============================================================
# Random secret for signing session tokens
SESSION_SECRET=
