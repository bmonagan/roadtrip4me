# ============================================================
# RoadTrip4Me — Production Environment Configuration
# ============================================================
# Copy to .env.prod and fill in real values for each field.
# Do NOT commit this file with secrets.
# ============================================================

# ============================================================
# Caddy / Let's Encrypt
# ============================================================
# Email for Let's Encrypt certificate notifications (required)
CADDY_EMAIL=

# Server port (default: 3000)
PORT=3000

# Trusted browser origins for CORS.
# Production value: https://roadtrip4me.com
CORS_ORIGIN=https://roadtrip4me.com

# App origin — used by Stripe success/cancel URLs and redirect callbacks.
# Production value: https://roadtrip4me.com
APP_ORIGIN=https://roadtrip4me.com

# ============================================================
# Database
# ============================================================
# PostgreSQL connection string
# Replace with your managed database (e.g., Supabase, AWS RDS, Neon)
DATABASE_URL=postgresql://user:password@host:5432/roadtrip4me

# Redis — required for rate limiting, session caching, and job queues
# Replace with managed Redis (e.g., Upstash, AWS ElastiCache)
REDIS_URL=redis://user:password@host:6379

# ============================================================
# Auth0 — Authentication & Authorization
# ============================================================
# Disable dev-mode auth bypass — MUST be false in production
AUTH_DISABLED=false

# Auth0 tenant domain (e.g., roadtrip4me.us.auth0.com)
AUTH0_DOMAIN=roadtrip4me.us.auth0.com

# Auth0 API Audience — the identifier for your Auth0 API resource.
# This is the scope used in access token requests.
AUTH0_AUDIENCE=https://api.roadtrip4me.com

# ============================================================
# Frontend Auth0 (baked into Vite build)
# ============================================================
# SPA Application Client ID — get from Auth0 dashboard → Applications → your web SPA
VITE_AUTH0_CLIENT_ID=

# Must match AUTH0_DOMAIN above
VITE_AUTH0_DOMAIN=roadtrip4me.us.auth0.com

# Must match AUTH0_AUDIENCE above
VITE_AUTH0_AUDIENCE=https://api.roadtrip4me.com

# ============================================================
# Map & Geocoding
# ============================================================
# Mapbox access token — required for interactive maps in the frontend
# Get from https://account.mapbox.com → Access Tokens
VITE_MAPBOX_TOKEN=

# Google Maps API key — required for geocoding, directions, and Places
# Restrict to your domain in Google Cloud Console → API keys → Application restrictions
GOOGLE_MAPS_API_KEY=

# ============================================================
# AI Services
# ============================================================
# DeepSeek API key — used for AI-powered trip planning and itinerary generation
# Get from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ============================================================
# Local Search
# ============================================================
# Yelp API key — for local business discovery (optional)
YELP_API_KEY=

# ============================================================
# Affiliate Partners
# ============================================================
# Booking.com affiliate ID — for hotel booking revenue sharing
# Get from https://publisher.booking.com
BOOKING_COM_AFFILIATE_ID=

# Expedia affiliate ID — for travel booking revenue sharing
# Get from Expedia Partner Solutions
EXPEDIA_AFFILIATE_ID=

# ============================================================
# Billing — Stripe (Premium Subscriptions)
# ============================================================
# Stripe Secret Key — from Stripe Dashboard → Developers → API keys
# Starts with sk_live_ in production
STRIPE_SECRET_KEY=

# Stripe Price ID — the subscription plan price identifier
# Get from Stripe Dashboard → Products → Prices → copy Price ID
STRIPE_PRICE_ID=

# Stripe Webhook Signing Secret — for verifying Stripe webhook events
# Get from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
