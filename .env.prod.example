# ============================================================
# RoadTrip4Me — Production Environment Configuration
# ============================================================
# Fly.io deployment: API secrets are set via `flyctl secrets set` (see
# .github/workflows/deploy.yml); VITE_* values are baked into the web bundle at
# build time and passed as Docker build args. This file is a reference for the
# variables that are actually read by the apps.
# Do NOT commit this file with real secrets.
# ============================================================

# ============================================================
# Network
# ============================================================
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=https://roadtrip4me.com

# Used by Stripe success/cancel URLs and auth redirects.
APP_ORIGIN=https://roadtrip4me.com

# ============================================================
# Database
# ============================================================
# Fly Postgres connection string (from `fly postgres info`).
DATABASE_URL=

# ============================================================
# Auth0 — API token validation
# ============================================================
AUTH0_DOMAIN=
# The Auth0 API identifier (Audience).
AUTH0_AUDIENCE=
# Must be false in production so the x-user-id dev fallback is disabled.
AUTH_DISABLED=false

# ============================================================
# Frontend (Vite build args — baked into the static bundle)
# ============================================================
VITE_API_URL=https://api.roadtrip4me.com
VITE_MAPBOX_TOKEN=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# ============================================================
# Google Maps
# ============================================================
GOOGLE_MAPS_API_KEY=

# ============================================================
# AI Services
# ============================================================
DEEPSEEK_API_KEY=

# ============================================================
# Affiliate Partners
# ============================================================
BOOKING_COM_AFFILIATE_ID=
# Booking.com sub-account id (optional)
BOOKING_COM_SID=
# Live Booking.com inventory — opt-in once the Affiliate API is approved.
BOOKING_COM_API_ENABLED=false
# Affiliate API endpoint + token supplied with partner approval.
BOOKING_COM_API_URL=
BOOKING_COM_API_TOKEN=

EXPEDIA_AFFILIATE_ID=
# Expedia Travel Redirect tenant id (optional)
EXPEDIA_TRAVELER_ID=

# Stay22 Allez — universal affiliate redirect across Booking.com, Expedia,
# Hotels.com, Vrbo, Agoda and GetYourGuide. Sign up free (hub.stay22.com) to
# get an AID; no partner approval or inventory API is required.
STAY22_AID=
# Optional click-attribution label (use underscores, not hyphens).
STAY22_CAMPAIGN=

# Travelpayouts — paste the dashboard "full link" for your hotel search,
# replacing the destination with the {destination} placeholder (and optionally
# {marker} / {subid}). The provider stays dormant until the template is set.
TRAVELPAYOUTS_HOTEL_URL_TEMPLATE=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_SUBID=

# ============================================================
# Billing — Stripe (Premium Subscriptions)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Webhook signing secret (Stripe → Developers → Webhooks → endpoint secret).
STRIPE_WEBHOOK_SECRET=
