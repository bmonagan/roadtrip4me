# Copy to .env.prod and fill in real values.

# Postgres
POSTGRES_PASSWORD=change-me

# Auth — MUST be real in production
AUTH_DISABLED=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.roadtrip4me.com

# API keys
GOOGLE_MAPS_API_KEY=
DEEPSEEK_API_KEY=

# Baked into the web build (required)
VITE_MAPBOX_TOKEN=
VITE_AUTH0_DOMAIN=${AUTH0_DOMAIN}
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=${AUTH0_AUDIENCE}
