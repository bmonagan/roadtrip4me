{
  "name": "roadtrip4me",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run --filter './apps/*' build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "bunx prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "prettier": "^3.3.3",
    "prisma": "^7.8.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
